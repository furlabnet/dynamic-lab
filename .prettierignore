# Prettier reads this like .gitignore: later lines win.

# 1. Only format these file types — everything else is ignored.
**/*
# Re-include folders: with "**/*" alone, every folder is ignored too, and a
# file inside an ignored folder can't be re-included by the lines below.
!**/*/
!**/*.js
!**/*.mjs
!**/*.cjs
!**/*.jsx
!**/*.ts
!**/*.mts
!**/*.cts
!**/*.tsx
!**/*.json
!**/*.css
!**/*.scss

# 2. Never format these, whatever their type (after the re-includes, so
#    they win).
**/package.json
**/package-lock.json
**/CHANGELOG.md
**/node_modules
**/dist
**/build
**/.next
**/.turbo
**/.yarn
**/.git
**/.svn
**/.hg
**/.vscode
**/public
**/vendor
**/vendors
**/chunks
**/migrations
# Generated by `yarn db:emit` — keep exactly as emitted.
**/src/prisma/contract.json
**/src/prisma/contract.d.ts
# Generated on every build (generate-build-info).
**/src/build-info.ts
