{
  "name": "dynamic-lab-monorepo",
  "private": true,
  "license": "MIT",
  "author": "Vedla Creative <code@vedla.ca>",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check .",
    "pages": "turbo run build --filter='./apps/*' && node scripts/assemble-pages.mjs",
    "prepare": "husky",
    "release": "yarn workspace @furlab/dynamic-lab release",
    "typecheck": "turbo run typecheck",
    "updates": "updates -u -d && yarn install"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "updates": "^19.3.0"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=20"
  }
}
