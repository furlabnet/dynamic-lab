{
  "name": "@furlab/dynamic-lab",
  "version": "0.1.0",
  "description": "Dynamic Lab - React UI Component Library in TypeScript with Tailwind CSS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/dynamic_lab.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.config.lib.ts",
    "dev": "vite",
    "format": "prettier --write --ignore-unknown  .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "updates": "^19.3.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "packageManager": "yarn@4.18.1"
}
