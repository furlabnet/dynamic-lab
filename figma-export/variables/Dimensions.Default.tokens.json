{
  "space": {
    "space-2": {
      "$type": "number",
      "$value": 2.0,
      "$description": "Brand product tag vertical padding; nav item gap.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-6": {
      "$type": "number",
      "$value": 6.0,
      "$description": "Pill-nav and menu inner padding; nav-label bottom margin.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-8": {
      "$type": "number",
      "$value": 8.0,
      "$description": "Toolbar and page-actions gap; nav link vertical padding.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-10": {
      "$type": "number",
      "$value": 10.0,
      "$description": "Nav link horizontal padding; brand lockup gap; toolbar vertical padding.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-12": {
      "$type": "number",
      "$value": 12.0,
      "$description": "Field horizontal padding; menu item padding; empty-state gap.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-16": {
      "$type": "number",
      "$value": 16.0,
      "$description": "Notice-panel padding; page-heading and timeline gaps; container gutter on phones.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-20": {
      "$type": "number",
      "$value": 20.0,
      "$description": "ui-panel padding below 640px; primary-button horizontal padding; dashboard gap.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-24": {
      "$type": "number",
      "$value": 24.0,
      "$description": "ui-panel padding from 640px; dialog padding; page-header column gap.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-28": {
      "$type": "number",
      "$value": 28.0,
      "$description": "Auth card padding; metric-card padding at its largest.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-32": {
      "$type": "number",
      "$value": 32.0,
      "$description": "Empty-panel padding; desktop dashboard gap; container gutter at its largest.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    },
    "space-40": {
      "$type": "number",
      "$value": 40.0,
      "$description": "Page-stack gap at its largest; ui-empty vertical padding.",
      "$extensions": {
        "com.figma.scopes": ["GAP", "WIDTH_HEIGHT"]
      }
    }
  },
  "radius": {
    "radius-sm": {
      "$type": "number",
      "$value": 6.0,
      "$description": "rounded-sm: small inner elements.",
      "$extensions": {
        "com.figma.scopes": ["CORNER_RADIUS"]
      }
    },
    "radius-md": {
      "$type": "number",
      "$value": 8.0,
      "$description": "rounded-md; icon-button, nav links, menu items, file-picker button.",
      "$extensions": {
        "com.figma.scopes": ["CORNER_RADIUS"]
      }
    },
    "radius-lg": {
      "$type": "number",
      "$value": 10.0,
      "$description": "`--radius`: buttons and form fields.",
      "$extensions": {
        "com.figma.scopes": ["CORNER_RADIUS"]
      }
    },
    "radius-xl": {
      "$type": "number",
      "$value": 14.0,
      "$description": "Menus, toolbars and pill-nav links (0.875rem).",
      "$extensions": {
        "com.figma.scopes": ["CORNER_RADIUS"]
      }
    },
    "radius-2xl": {
      "$type": "number",
      "$value": 16.0,
      "$description": "ui-panel, notice-panel, dashboard sidebar.",
      "$extensions": {
        "com.figma.scopes": ["CORNER_RADIUS"]
      }
    },
    "radius-3xl": {
      "$type": "number",
      "$value": 20.0,
      "$description": "surface-card, dialogs, auth card, empty-panel, hero icon.",
      "$extensions": {
        "com.figma.scopes": ["CORNER_RADIUS"]
      }
    },
    "radius-full": {
      "$type": "number",
      "$value": 999.0,
      "$description": "Status pills, filter chips, avatars, the brand product tag.",
      "$extensions": {
        "com.figma.scopes": ["CORNER_RADIUS"]
      }
    }
  },
  "size": {
    "touch-target": {
      "$type": "number",
      "$value": 44.0,
      "$description": "Minimum height of buttons, fields, chips and phone nav links (min-h-11).",
      "$extensions": {
        "com.figma.scopes": ["WIDTH_HEIGHT"]
      }
    },
    "control-compact": {
      "$type": "number",
      "$value": 36.0,
      "$description": "icon-button; toolbar fields and buttons from 1024px; desktop nav links.",
      "$extensions": {
        "com.figma.scopes": ["WIDTH_HEIGHT"]
      }
    },
    "container-max": {
      "$type": "number",
      "$value": 1280.0,
      "$description": ".site-container and .dash-shell max width (80rem).",
      "$extensions": {
        "com.figma.scopes": ["WIDTH_HEIGHT"]
      }
    },
    "sidebar-width": {
      "$type": "number",
      "$value": 248.0,
      "$description": "Dashboard and Backstage sidebar (15.5rem); Backstage rail collapses to 68px.",
      "$extensions": {
        "com.figma.scopes": ["WIDTH_HEIGHT"]
      }
    }
  }
}
