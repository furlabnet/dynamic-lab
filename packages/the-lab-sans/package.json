{
  "name": "@furlab/the-lab-sans",
  "version": "0.1.0-beta.1",
  "description": "The Lab Sans, the Furlab typeface: 8 weights with italics, as WOFF2 web fonts with a ready-made @font-face stylesheet, and OpenType files.",
  "keywords": [
    "font",
    "typeface",
    "woff2",
    "furlab"
  ],
  "homepage": "https://furlab.gitlab.io/dynamic-lab/the-lab-sans/",
  "bugs": {
    "url": "https://gitlab.com/furlab/dynamic-lab/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/furlab/dynamic-lab",
    "directory": "packages/the-lab-sans"
  },
  "license": "MIT",
  "author": "Vedla Creative <code@vedla.ca>",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@furlab/source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next": {
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./package.json": "./package.json",
    "./the-lab-sans.css": "./dist/the-lab-sans.css",
    "./otf/*": "./src/fonts/*",
    "./fonts/*": "./dist/fonts/*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "style": "./dist/the-lab-sans.css",
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "prepack": "yarn build",
    "release": "node ../../scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --config-loader tsx --watch"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.3",
    "@types/node": "^26.6.5",
    "@types/wawoff2": "^1.0.2",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "tsdown": "0.23.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wawoff2": "2.0.1"
  },
  "optionalDependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
