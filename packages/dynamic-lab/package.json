{
  "name": "@furlab/dynamic-lab",
  "version": "0.1.0-beta.2",
  "description": "Dynamic Lab: the React component library for The Furlab Project. TypeScript, Tailwind CSS v4, two brands (Dynamic and Backstage), named colour themes, light and dark modes.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "tailwindcss",
    "typescript",
    "furlab"
  ],
  "homepage": "https://furlab.gitlab.io/dynamic-lab/",
  "bugs": {
    "url": "https://gitlab.com/furlab/dynamic-lab/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/furlab/dynamic-lab",
    "directory": "packages/dynamic-lab"
  },
  "license": "MIT",
  "author": "Vedla Creative <code@vedla.ca>",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:css": "tailwindcss -i src/styles/dynamic-lab.css -o dist/styles.css --minify",
    "dev": "tsdown --watch",
    "prepack": "yarn build",
    "release": "node ../../scripts/release.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/cli": "4.3.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "bumpp": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.2.15",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.23.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
